{#-
  theme_css(user, kind) — the card_mod style body for one card.
  kind: 'card'   full themed surface (background, border, shadow, blur)
        'exempt' theme variables only, all chrome stripped
        'chip'   radius/font/shadow/blur, keeps the card's own background
        'chrome' primary-tinted surface (nav bar and friends), 40% blur
-#}
{%- macro theme_css(user, kind) -%}
{%- set u = '<entity_31>' if user == '<entity_31>' else '<entity_32>' -%}
{%- set style = states('input_select.theme_style_' ~ u) -%}
{%- set pal = states('input_select.theme_palette_' ~ u) -%}
{%- set mode_pref = states('input_select.theme_mode_' ~ u) | lower -%}
{%- set modes = [mode_pref] if mode_pref in ['light', 'dark'] else ['dark', 'light'] -%}
{%- set opacity_override = states('input_number.theme_card_opacity_' ~ u) | float(-1) -%}
{%- set blur_override = states('input_number.theme_card_blur_' ~ u) | float(-1) -%}
{%- set colors = palette_colors.get(pal, palette_colors['Indigo']) -%}
{%- set severity_mode = states('input_select.theme_severity_colors_' ~ u) -%}
{#- Resolve severity colors: "Standard" uses fixed universal values so
    severity meaning is visually consistent across all palettes. "Match
    Palette" uses the palette's own severity tints for visual cohesion.
    "Match Identity" maps the palette's identity colors (primary, accent,
    state_on, state_off) onto the severity slots for full palette
    immersion at the cost of all severity distinction. -#}
{%- if severity_mode == 'Match Palette' -%}
  {%- set sev = colors -%}
{%- elif severity_mode == 'Match Identity' -%}
  {%- set sev = {'error': colors.state_off, 'warning': colors.accent, 'success': colors.state_on, 'info': colors.primary} -%}
{%- else -%}
  {%- set sev = universal_severity -%}
{%- endif -%}
{%- set radius = '4px' if style == 'Neon' else '18px' -%}
{%- set font = "'Share Tech Mono', monospace" if style == 'Neon' else 'inherit' -%}
{%- set blur = (style_blur.get(style, 0) if blur_override < 0 else blur_override) | int -%}
{%- if style == 'Neon' %}
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
{%- endif -%}
{%- for m in modes %}
{%- set sm = style_by_mode[m] %}
{%- set opacity = (sm.opacity_default.get(style, 95) if opacity_override < 0 else opacity_override) | int %}
{%- set card_bg = 'rgba(' ~ sm.card_rgb.get(style, sm.card_rgb_default) ~ ',' ~ ((opacity / 100) | round(2)) ~ ')' %}
{%- if modes | length > 1 %}
@media (prefers-color-scheme: {{ m }}) {
{%- endif %}
ha-card {
  --primary-color: {{ colors.primary }};
  --accent-color: {{ colors.accent }};
{#- Chips sit at section-grid top level, not inside a parent ha-card, so they
    need these variables set directly — they won't inherit from a parent card.
    State colors always follow the palette; severity colors respect the
    user's severity color mode preference (Standard vs Match Palette). -#}
{%- if kind in ['card', 'exempt', 'chip'] %}
  --state-on-color: {{ colors.state_on }};
  --state-off-color: {{ colors.state_off }};
  --success-color: {{ sev.success }};
  --warning-color: {{ sev.warning }};
  --error-color: {{ sev.error }};
  --info-color: {{ sev.info }};
{%- endif %}
{%- if kind != 'exempt' %}
  border-radius: {{ radius }} !important;
{%- endif %}
  font-family: {{ font }} !important;
{%- if kind == 'card' %}
  position: relative;
  overflow: hidden;
  background: {{ card_bg }} !important;
  border: {{ sm.border.get(style, 'none') }} !important;
  box-shadow: {{ sm.shadow.get(style, 'none') }} !important;
{%- elif kind == 'chrome' %}
  position: relative;
  overflow: hidden;
  background: color-mix(in srgb, {{ colors.primary }} 14%, {{ card_bg }}) !important;
  border: {{ sm.border.get(style, 'none') }} !important;
  box-shadow: {{ sm.shadow.get(style, 'none') }} !important;
{%- elif kind == 'chip' %}
  box-shadow: {{ sm.shadow.get(style, 'none') }} !important;
{%- elif kind == 'exempt' %}
  background: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  box-shadow: none !important;
  border: none !important;
{%- endif %}
{%- if kind in ['card', 'chip'] and blur > 0 %}
  backdrop-filter: blur({{ blur }}px) saturate(1.2);
  -webkit-backdrop-filter: blur({{ blur }}px) saturate(1.2);
{%- elif kind == 'chrome' and blur > 0 %}
  backdrop-filter: blur({{ (blur * 0.4) | round(0) | int }}px) saturate(1.2);
  -webkit-backdrop-filter: blur({{ (blur * 0.4) | round(0) | int }}px) saturate(1.2);
{%- endif %}
}
{%- if modes | length > 1 %}
}
{%- endif %}
{%- endfor %}
{%- if kind == 'exempt' %}
ha-card::before {
  content: none !important;
}
{%- endif %}
{%- endmacro -%}

{#-
  active_outline(user, helper, option) — selection outline for Appearance
  page picker tiles. Emits a primary-colored outline on the ha-card when
  the user's input_select for `helper` matches `option`. Append this to
  the card_mod `.` style alongside theme_css — it must be at the host
  level, not inside `$:`, because ha-card IS the host element.
-#}
{%- macro active_outline(user, helper, option) -%}
{%- set u = '<entity_31>' if user == '<entity_31>' else '<entity_32>' -%}
{%- if is_state('input_select.' ~ helper ~ '_' ~ u, option) %}
ha-card {
  outline: 2px solid var(--primary-color) !important;
  outline-offset: -2px;
}
{%- endif %}
{%- endmacro -%}

{#-
  background_outline(user, match) — selection outline for Background picker
  tiles. The background helper is an input_text (not input_select), with
  three match modes:
    'auto'   — active when background is auto, unknown, unavailable, or empty
    'custom' — active when background starts with '#' (hex color)
    any other value — exact match against the background state
-#}
{%- macro background_outline(user, match) -%}
{%- set u = '<entity_31>' if user == '<entity_31>' else '<entity_32>' -%}
{%- set bg = states('input_text.theme_background_' ~ u) -%}
{%- set active = (match == 'auto' and bg in ['auto', 'unknown', 'unavailable', '']) or
                 (match == 'custom' and bg.startswith('#')) or
                 (match != 'auto' and match != 'custom' and bg == match) -%}
{%- if active %}
ha-card {
  outline: 2px solid var(--primary-color) !important;
  outline-offset: -2px;
}
{%- endif %}
{%- endmacro -%}

{#-
  view_background_css(user) — the fixed page-background card's style body:
  the lovelace background plus the Glow style's radial orbs.
-#}
{%- macro view_background_css(user) -%}
{%- set u = '<entity_31>' if user == '<entity_31>' else '<entity_32>' -%}
{%- set style = states('input_select.theme_style_' ~ u) -%}
{%- set pal = states('input_select.theme_palette_' ~ u) -%}
{%- set bg = states('input_text.theme_background_' ~ u) -%}
{%- set mode_pref = states('input_select.theme_mode_' ~ u) | lower -%}
{%- set modes = [mode_pref] if mode_pref in ['light', 'dark'] else ['dark', 'light'] -%}
{%- set glow_active = style == 'Glow' and bg in ['unknown', 'unavailable', 'auto', ''] -%}
{%- for m in modes %}
{%- set sm = style_by_mode[m] %}
{%- set pm = palette_by_mode[m].get(pal, palette_by_mode[m]['Indigo']) %}
{%- if bg == 'none' %}
{%- set page_bg = 'transparent' %}
{%- elif bg.startswith('#') %}
{%- set page_bg = bg %}
{%- elif bg not in ['unknown', 'unavailable', 'auto', ''] %}
{%- set page_bg = "center / cover no-repeat fixed url('/local/themes/backgrounds/" ~ bg ~ "')" %}
{%- elif style == 'Glass' %}
{%- set page_bg = pm.glass_bg %}
{%- elif style in sm.bg_fallback %}
{%- set page_bg = sm.bg_fallback[style] %}
{%- else %}
{%- set page_bg = pm.surface %}
{%- endif %}
{%- if modes | length > 1 %}
@media (prefers-color-scheme: {{ m }}) {
{%- endif %}
ha-card {
  background: {{ page_bg }} !important;
}
{%- if glow_active %}
ha-card::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(140% 120% at 108% -8%, {{ pm.glow1 }} 0%, transparent 62%),
    radial-gradient(130% 116% at -8% 108%, {{ pm.glow2 }} 0%, transparent 62%),
    radial-gradient(125% 112% at 50% 132%, {{ pm.glow3 }} 0%, transparent 66%);
  mix-blend-mode: {{ sm.glow_blend }};
  opacity: {{ sm.glow_opacity }};
}
{%- endif %}
{%- if modes | length > 1 %}
}
{%- endif %}
{%- endfor %}
{%- endmacro -%}

{#-
  theme_value(account, prop) — single resolved values for the Appearance
  page (labels, picker grids). `account` is a literal account name, NOT the
  card-mod `user` variable — non-card_mod templates don't receive it.
  prop: 'primary' | 'card_opacity' | 'card_blur' | 'account'
  For mode-dependent defaults, a fixed mode resolves exactly; System
  displays the dark-mode default.
-#}
{%- macro theme_value(account, prop) -%}
{%- set u = '<entity_31>' if account == '<entity_31>' else '<entity_32>' -%}
{%- set style = states('input_select.theme_style_' ~ u) -%}
{%- if prop == 'account' -%}
{{- u -}}
{%- elif prop == 'primary' -%}
{{- palette_colors.get(states('input_select.theme_palette_' ~ u), palette_colors['Indigo']).primary -}}
{%- elif prop == 'card_opacity' -%}
{%- set mode_pref = states('input_select.theme_mode_' ~ u) | lower -%}
{%- set m = mode_pref if mode_pref in ['light', 'dark'] else 'dark' -%}
{%- set override = states('input_number.theme_card_opacity_' ~ u) | float(-1) -%}
{{- (style_by_mode[m].opacity_default.get(style, 95) if override < 0 else override) | int -}}
{%- elif prop == 'card_blur' -%}
{%- set override = states('input_number.theme_card_blur_' ~ u) | float(-1) -%}
{{- (style_blur.get(style, 0) if override < 0 else override) | int -}}
{%- endif -%}
{%- endmacro -%}

{#-
  style_tile_outer(user, style_name) — card_mod `.:` CSS for a style
  preview tile on the Appearance page. Emits background, selection border,
  and text color overrides. For System mode, wraps in @media blocks.
-#}
{%- macro style_tile_outer(user, style_name) -%}
{%- set u = '<entity_31>' if user == '<entity_31>' else '<entity_32>' -%}
{%- set mode_pref = states('input_select.theme_mode_' ~ u) | lower -%}
{%- set modes = [mode_pref] if mode_pref in ['light', 'dark'] else ['light', 'dark'] -%}
{%- set is_selected = is_state('input_select.theme_style_' ~ u, style_name) -%}
{%- if style_name == 'Neon' %}
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&display=swap');
{%- endif %}
{%- for m in modes %}
{%- set p = style_tile_preview[m][style_name] %}
{%- if modes | length > 1 %}
@media (prefers-color-scheme: {{ m }}) {
{%- endif %}
ha-card {
{%- if is_selected %}
  border: 2px solid var(--primary-color) !important;
{%- if style_name == 'Neon' %}
  box-shadow: 0 0 8px rgba(0,229,255,0.3) !important;
{%- endif %}
{%- endif %}
  background: {{ p.bg }} !important;
{%- if p.get('blur') %}
  backdrop-filter: blur({{ p.blur }}px);
{%- endif %}
{%- if style_name == 'Neon' %}
  border-radius: 4px !important;
{%- endif %}
  --primary-text-color: {{ p.text }};
  --card-primary-color: {{ p.text }};
}
{%- if modes | length > 1 %}
}
{%- endif %}
{%- endfor %}
{%- endmacro -%}

